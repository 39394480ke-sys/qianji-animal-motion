# Keep directory placeholders while excluding generated data and results.
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
outputs/*
!outputs/.gitkeep
videos/
weights/
.cache/

# Source media and model artifacts.
*.avi
*.mov
*.mp4
*.mkv
*.webm
*.fbx
*.glb
*.h5
*.hdf5
*.pt
*.pth
*.ckpt
*.onnx

# Python, tooling, and local environment files.
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
.coverage
htmlcov/
.venv/
venv/
env/
.env
.DS_Store
